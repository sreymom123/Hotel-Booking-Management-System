generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String
  role          String
  phone         String?
  profile_image String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model rooms {
  id           Int      @id @default(autoincrement())
  room_number  String
  room_type    String
  name         String
  floor_number Int?
  location     String?
  capacity     Int
  price        Decimal
  description  String?
  image_url    String?
  status       String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model bookings {
  id              Int      @id @default(autoincrement())
  user_id         Int
  room_id         Int
  booking_code    String
  check_in        DateTime
  check_out       DateTime
  guest_count     Int
  total_days      Int
  purpose         String?
  special_request String?
  total_price     Decimal
  status          String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model payments {
  id             Int       @id @default(autoincrement())
  booking_id     Int
  payment_code   String
  amount         Decimal
  payment_method String
  status         String
  transaction_no String?
  paid_at        DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
}

model checkin_checkout_logs {
  id             Int       @id @default(autoincrement())
  booking_id     Int
  checked_in_by  Int
  checked_out_by Int?
  check_in_time  DateTime?
  check_out_time DateTime?
  note           String?
  created_at     DateTime  @default(now())
}

model room_images {
  id         Int      @id @default(autoincrement())
  room_id    Int
  image_url  String
  created_at DateTime @default(now())
}
